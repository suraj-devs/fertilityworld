{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "build",
  "compatibility_date": "2026-07-26",
  "main": "./worker/index.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CONTACT_TO": "surajsh64@gmail.com",
    "CONTACT_FROM": "noreply@fertilityworld.in"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
